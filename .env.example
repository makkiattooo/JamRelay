# ============================================================
# Spotify OAuth
# Create an app at the Spotify Developer Dashboard.
# ============================================================

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local development:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5267/auth/providers/spotify/callback

SPOTIFY_MARKET=PL
SPOTIFY_READ_CONCURRENCY=12

# ============================================================
# Optional SoundCloud OAuth 2.1 + PKCE. Each provider connection has its own
# encrypted credentials and capability set; never reuse MCP OAuth secrets here.
# Requires a SoundCloud application; leave all three blank to disable.
# ============================================================

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:5267/auth/providers/soundcloud/callback

# Optional Apple Music API credentials. This is not Spotify-style OAuth:
# the server signs developer tokens with the private .p8 key, while a user
# authorizes MusicKit in a client/browser and submits the Music User Token
# through the protected owner route documented in docs/configuration.md.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us

# Optional official YouTube Data API v3 OAuth. This models YouTube playlists
# of videos, not an unofficial YouTube Music API. playlistItems writes consume
# quota units; credentials are stored encrypted by connection ID.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5267/auth/providers/youtube/callback

# Optional alternate resolver API. Disabled when URL is unset. The API must
# return JSON: { "candidates": [{ "spotifyUrl": "https://open.spotify.com/track/..." }] }.
ALTERNATE_TRACK_RESOLVER_URL=
ALTERNATE_TRACK_RESOLVER_NAME=web_search
ALTERNATE_TRACK_RESOLVER_TOKEN=
ALTERNATE_TRACK_RESOLVER_TIMEOUT_MS=2500
ALTERNATE_TRACK_RESOLVER_MAX_RESULTS=5


# ============================================================
# Server
# ============================================================

HOST=0.0.0.0
PORT=5267
PUBLIC_BASE_URL=http://127.0.0.1:5267

TRUST_PROXY=false
LOG_LEVEL=info
JAMRELAY_TOOLSET=all

# Persistent JamRelay State DB. These are infrastructure settings, not secrets.
# Local default: ./data/jamrelay.db
# Docker production: /data/jamrelay.db (Compose sets JAMRELAY_DATA_DIR=/data).
JAMRELAY_DATA_DIR=
# Optional explicit path; overrides JAMRELAY_DATA_DIR when set.
JAMRELAY_DB_PATH=


# ============================================================
# Token encryption
# Generate a strong random key. Never commit the real value.
# ============================================================

TOKEN_ENCRYPTION_KEY=

# Encrypted multi-provider credential store, keyed by connection ID.
# All provider credentials use this store.
# Local default: ./data/provider-credentials.json
# Docker default (NODE_ENV=production): /data/provider-credentials.json
PROVIDER_CREDENTIAL_STORE_PATH=


# ============================================================
# MCP authentication
# Optional static Bearer token, useful for development,
# MCP Inspector and manual clients.
# bearer = accept MCP_API_KEY in addition to configured OAuth.
# none   = disable the static API key; OAuth can still authenticate.
# ============================================================

MCP_AUTH_MODE=none
MCP_API_KEY=


# ============================================================
# MCP OAuth
# One deployment can now serve multiple OAuth clients.
# ============================================================

# Owner approval password. Required to actually authorize any OAuth client.
# It is never sent to the AI client.
MCP_OAUTH_OWNER_SECRET=

# OAuth state/token/DCR registry store.
# Local default: ./data/mcp-oauth.json
# Docker default (NODE_ENV=production): /data/mcp-oauth.json
MCP_OAUTH_STORE_PATH=

# Optional static multi-client registry.
# Local default: ./data/mcp-oauth-clients.json
# Docker default (NODE_ENV=production): /data/mcp-oauth-clients.json
# Missing file = empty static registry.
MCP_OAUTH_CLIENTS_PATH=

# Dynamic Client Registration (RFC 7591).
# true is recommended for Claude, Gemini CLI, VS Code and other clients that
# automatically register localhost callbacks. Set false to allow only
# pre-registered clients.
MCP_OAUTH_DCR_ENABLED=true

# Translation/docs maintenance does not require additional environment variables.
