# ============================================================
# Spotify OAuth
# Create an app at the Spotify Developer Dashboard.
# ============================================================

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local development:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

SPOTIFY_MARKET=PL
# Optional alternate resolver API. Disabled when URL is unset. The API must
# return JSON: { "candidates": [{ "spotifyUrl": "https://open.spotify.com/track/..." }] }.
ALTERNATE_TRACK_RESOLVER_URL=
ALTERNATE_TRACK_RESOLVER_NAME=web_search
ALTERNATE_TRACK_RESOLVER_TOKEN=
ALTERNATE_TRACK_RESOLVER_TIMEOUT_MS=2500
ALTERNATE_TRACK_RESOLVER_MAX_RESULTS=5


# ============================================================
# Server
# ============================================================

HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000

TRUST_PROXY=false
LOG_LEVEL=info

# Persistent TuneLink State DB. These are infrastructure settings, not secrets.
# Local default: ./data/tunelink.db
# Docker production: /data/tunelink.db (Compose sets TUNELINK_DATA_DIR=/data)
TUNELINK_DATA_DIR=
# Optional explicit path; overrides TUNELINK_DATA_DIR when set.
TUNELINK_DB_PATH=


# ============================================================
# Token encryption
# Generate a strong random key. Never commit the real value.
# ============================================================

TOKEN_ENCRYPTION_KEY=

# Encrypted Spotify token store.
# Local default: ./data/spotify-token.json
# Docker default (NODE_ENV=production): /data/spotify-token.json
SPOTIFY_TOKEN_STORE_PATH=


# ============================================================
# MCP authentication
# Optional static Bearer token, useful for development,
# MCP Inspector and manual clients.
# bearer = accept MCP_API_KEY in addition to configured OAuth.
# none   = disable the static API key; OAuth can still authenticate.
# ============================================================

MCP_AUTH_MODE=none
MCP_API_KEY=


# ============================================================
# MCP OAuth
# One deployment can now serve multiple OAuth clients.
# ============================================================

# Owner approval password. Required to actually authorize any OAuth client.
# It is never sent to the AI client.
MCP_OAUTH_OWNER_SECRET=

# OAuth state/token/DCR registry store.
# Local default: ./data/mcp-oauth.json
# Docker default (NODE_ENV=production): /data/mcp-oauth.json
MCP_OAUTH_STORE_PATH=

# Optional static multi-client registry.
# Local default: ./data/mcp-oauth-clients.json
# Docker default (NODE_ENV=production): /data/mcp-oauth-clients.json
# Missing file = empty static registry.
MCP_OAUTH_CLIENTS_PATH=

# Dynamic Client Registration (RFC 7591 compatibility).
# true is recommended for Claude, Gemini CLI, VS Code and other clients that
# automatically register localhost callbacks. Set false to allow only
# pre-registered clients.
MCP_OAUTH_DCR_ENABLED=true

# Legacy single pre-registered client. Kept for backwards compatibility and
# useful for ChatGPT or another provider that gives you an exact callback URL.
# Leave all three blank if you use only DCR and/or MCP_OAUTH_CLIENTS_PATH.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=

# Translation/docs maintenance does not require additional environment variables.
