{
  "name": "jamrelay",
  "version": "1.5.4",
  "description": "Self-hosted provider-neutral MCP server for music automation across multiple providers.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "backup": "node --import tsx scripts/backup.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run --maxWorkers=1",
    "db:migration:new": "node --import tsx scripts/create-migration.ts",
    "deploy:vps": "node ./scripts/deploy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts examples docs .github eslint.config.js .prettierrc.json tsconfig.json package.json \"*.md\" \"*.yml\"",
    "format:check": "prettier --check src tests scripts examples docs .github eslint.config.js .prettierrc.json tsconfig.json package.json \"*.md\" \"*.yml\"",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "npm run docs:generate && npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run docs:build",
    "docs:generate": "node --import tsx scripts/generate-docs.ts",
    "docs:check": "node --import tsx scripts/check-docs.ts",
    "release:check": "npm run check",
    "docs:sync-translations": "node --import tsx scripts/sync-translation-hashes.ts",
    "prepare": "husky",
    "operator": "node --env-file-if-exists=.env --import tsx src/operator.ts",
    "smoke:local": "node --import tsx scripts/smoke-local.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "pino": "9.14.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.0.0",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.1",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "3.2.7"
  },
  "bin": {
    "jamrelay": "dist/cli.js"
  },
  "files": [
    "dist/",
    "db/migrations/*.sql",
    "assets/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    ".github/cli/notices.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makkiattooo/JamRelay.git"
  }
}
